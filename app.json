{
  "expo": {
    "name": "WYZEN AI",
    "slug": "wyzen-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.wyzen.ai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#080512"
      },
      "permissions": [
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "WRITE_CALENDAR",
        "READ_CALENDAR",
        "CALL_PHONE"
      ]
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "WYZEN AI precisa do microfone para receber comandos de voz.",
          "speechRecognitionPermission": "WYZEN AI usa reconhecimento de voz para compreender os teus comandos."
        }
      ],
      [
        "llama.rn",
        {
          "enableOpenCL": false,
          "forceCxx20": true
        }
      ],
      "expo-contacts",
      "expo-calendar",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "7c9e460c-872f-4525-8f87-ef8f9bc95592"
      }
    }
  }
}
